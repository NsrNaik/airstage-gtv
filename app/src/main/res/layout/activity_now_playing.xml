<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The cover art again, blurred and darkened, filling the screen. -->
    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="112dp"
        android:paddingEnd="112dp">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="340dp"
            android:layout_height="340dp"
            android:background="@drawable/cover_frame"
            android:elevation="24dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <dev.airplaytv.ScrollingTextView
                android:id="@+id/source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_airplay"
                android:drawablePadding="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:letterSpacing="0.06"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp" />

            <dev.airplaytv.ScrollingTextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp" />

            <dev.airplaytv.ScrollingTextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#E6FFFFFF"
                android:textSize="22sp" />

            <dev.airplaytv.ScrollingTextView
                android:id="@+id/album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#99FFFFFF"
                android:textSize="18sp" />

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="44dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/elapsed"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#B3FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/remaining"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#B3FFFFFF"
                    android:textSize="16sp"
                    android:gravity="end" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
